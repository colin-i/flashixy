set -e
qq ~/o/wstbld files.txt
. mini
a () {
	if [ -z "${no_min}" ]; then
		mini $1 ../$1
	else
		mv $1 ..
	fi
}
a index.html
a member.html
a scores.html

cp x ../../index.html
a x

cd ..
mv ./x ../swf_backup/universe/index.html

if [ -z "${no_min}" ]; then
	cd ..
	vs=~/Desktop/arh/index.html
	js-beautify ./swf_backup/universe/index.html > ${vs}
	echo ${vs}2 ${vs}
	diff ${vs}2 ${vs} || {
		echo y \?
		read -n1 -t $((60*60*24)) ans
		if [ ${ans} = y ]; then
			mv ${vs} ${vs}2
		fi
	}
fi
