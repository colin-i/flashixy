//at android first click on swf full size problem
document.getElementById("game").style="position: fixed;top: 20px;left: 0;right: 0;bottom: 0;";

window.Game = {};//for js->as callback

async function data_read() {
	const response = await fetch("plays.txt");
	const txt = await response.text();
	const text = txt.split("|");

	const plays = text[0].split(";");
	const plays_index = plays[0].split(" ").map(Number);
	window.sorts_play=function(){
		return plays_index;
	}
	const plays_total = plays[1].split(" ").map(Number);
	window.sorts_plays=function(){
		return plays_total;
	}

	const rates = text[1].split(";");
	const rates_index = rates[0].split(" ").map(Number);
	window.sorts_rate=function(){
		return rates_index;
	}
	const rates_total = rates[1].split(" ").map(Number);
	window.sorts_rates=function(){
		return rates_total;
	}
}
