
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-app.js";

  import {
    getAuth,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-auth.js";

  import {
    doc,
    getDoc,
    getFirestore,
    increment,
    setDoc,
    updateDoc
  } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-firestore.js";

<!-- -->

<!-- -->

  window.addPlay = function(name) {
    const ref = doc(db, "plays", "plays");
    updateDoc( ref,//must be initialized //await
      {
         [name]: increment(1)
      }
    ); //setDoc will replace all document if not with ,{ merge : true }
  };
  window.submitScore = async function(name, score) {
    try{
      if (ins) {
        await setDoc(nameRef, {
          score: score
        });
      } else {
        const ref = doc(db, name, "a");//this can't be an overwrite, normal ids are 28 characters
        await updateDoc( ref, {//must be initialized
          score: score
        });
      }
    } catch (e) {//errors are normal since here only the highscore can go through
      console.error(e);
    }
  };

  async function rate_game(ref, name, rate) {
      const oldSnap = await getDoc(ref);
      if (oldSnap.data().rate != undefined){
        updateDoc( ref, {//await
          rate: rate
        });
      }else{
        setDoc( ref, {//await
          rate: rate
        },{ merge : true });
      }
  }
  window.rateGame = function(name, rate) {
      let ref = nameRef;
      if (!ins) ref = doc(db, name, "a");
      rate_game(ref, name, rate);
  };

  onAuthStateChanged(auth, async (user) => {//this will fire at least once
    if (user) {
      nameRef = doc(db, "Chambers", user.uid);
      ins = true;
    }
  });
</script>

