
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-app.js";

  import {
    getAuth,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-auth.js";

  import {
    doc,
    getDoc,
    getFirestore,
    increment,
    setDoc,
    runTransaction,
    updateDoc
  } from "https://www.gstatic.com/firebasejs/12.12.1/firebase-firestore.js";

<!-- -->

<!-- -->

  window.addPlay = function(name) {
    const ref = doc(db, "plays", "plays");
    updateDoc( ref,//must be initialized 1/4 //await
      {
         [name]: increment(1)
      }
    ); //setDoc will replace all document if not with ,{ merge : true }
  };
  window.submitScore = async function(name, score) {
    try{
      if (ins) {
        await setDoc(nameRef, {
          score: score
        }, { merge: true });//merge with rate
      } else {
        const ref = doc(db, name, "a");//this can't be an overwrite, normal ids are 28 characters
        await updateDoc( ref, {//must be initialized 2/4
          score: score
        });
      }
    } catch (e) {//errors are normal since here only the highscore can go through
      console.error(e);
    }
  };

  window.rateGame = async function(game, rate) {
      let ref = nameRef;
      if (!ins) ref = doc(db, game, "a");

      const starsRef = doc(db, "plays", "stars");
      const starsSumRef = doc(db, "plays", "stars_sum");

      await runTransaction(db, async (transaction) => {
        const oldSnap = await transaction.get(ref);
        if (oldSnap.exists() && oldSnap.data().rate != undefined) {
          const oldRate = oldSnap.data().rate;
          const diff = rate - oldRate;
          if ( diff != 0 ){
            transaction.update(ref, {
              rate: rate
            });
            transaction.update( starsSumRef, {//must be initialized 3/4
              [game]: increment(diff)
            });
          }
        }else{
          transaction.set( ref, {
            rate: rate
          }, { merge: true });//merge with score
          transaction.update( starsSumRef, {//must be initialized 3/3
            [game]: increment(rate)
          });
          transaction.update( starsRef, {//must be initialized 4/4
            [game]: increment(1)
          });
        }
      });
      window.requestRate(game);
  }
  window.requestRate = async function(game) {
      let ref = nameRef;
      if (!ins) ref = doc(db, game, "a");

      const snap = await getDoc(ref);
      if(snap.exists()){//authenticated users
        let rate = snap.data().rate;
        if(rate){
          window.Game.player.onRateLoaded(rate);
        }
      }
  }

  onAuthStateChanged(auth, async (user) => {//this will fire at least once
    if (user) {
      nameRef = doc(db, "Chambers", user.uid);
      ins = true;
    }
  });
</script>

